{
  "name": "cca-f-revision",
  "private": true,
  "type": "module",
  "description": "Corpus de révision CCAR-F. Le site est statique ; ce manifeste n'outille que les contrôles et les rapports.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "check": "npm run check:questions && npm run check:nav && npm run check:links && npm run check:quizzes && npm run check:runtime && npm run check:courses",
    "check:questions": "node tools/check-questions.mjs",
    "check:nav": "node tools/check-nav.mjs",
    "check:links": "node tools/check-links.mjs",
    "check:quizzes": "node tools/check-quizzes.mjs",
    "check:runtime": "node tools/check-runtime.mjs",
    "check:courses": "node tools/check-courses.mjs",
    "fix:nav": "node tools/check-nav.mjs --fix",
    "build:courses": "po4a --force courses/po4a.conf",
    "render:courses": "node tools/render-courses.mjs",
    "report": "npm run report:length && npm run report:dupes && npm run report:diacritics",
    "report:length": "node tools/report-length-tell.mjs",
    "report:dupes": "node tools/report-duplicates.mjs",
    "report:diacritics": "node tools/report-diacritics.mjs",
    "test": "node --test tools/**/*.test.mjs",
    "test:mutation": "node tools/lib/mutation-check.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "markdown-it": "^15.0.1",
    "markdown-it-container": "^4.0.0"
  }
}

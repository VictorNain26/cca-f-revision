{
  "name": "cca-f-revision",
  "private": true,
  "type": "module",
  "description": "Corpus de révision CCAR-F. Le site est statique ; ce manifeste ne sert qu'aux contrôles qualité.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "check": "npm run check:chapters && npm run check:questions && npm run check:length && npm run check:dupes && npm run check:nav && npm run check:links && npm run check:diacritics && npm run check:quizzes && npm run check:runtime && npm run check:courses",
    "check:chapters": "node tools/check-chapters.mjs",
    "check:questions": "node tools/check-questions.mjs --strict",
    "check:nav": "node tools/check-nav.mjs",
    "fix:nav": "node tools/check-nav.mjs --fix",
    "check:links": "node tools/check-links.mjs",
    "check:diacritics": "node tools/check-diacritics.mjs",
    "check:quizzes": "node tools/check-quizzes.mjs",
    "check:runtime": "node tools/check-runtime.mjs",
    "check:length": "node tools/check-length-tell.mjs --enforce",
    "test": "node --test tools/**/*.test.mjs",
    "check:dupes": "node tools/check-duplicates.mjs --enforce",
    "build:courses": "po4a --force courses/po4a.conf",
    "check:courses": "node tools/check-courses.mjs",
    "test:mutation": "node tools/lib/mutation-check.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
